# Everything under data/ is either re-fetchable raw cache or derived output
# (DuckDB, grade_master.*). The working DuckDB is persisted on the data-state
# branch by CI instead, not on main.
data/

# site/ is entirely generated: scripts/export_parquet.py writes site/data/*.parquet
# and `npm run build` (in frontend/) writes the rest. CI builds both fresh each run
# and deploys straight to Pages -- none of it is committed to any branch.
site/

# Node (frontend/)
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc

# Misc debug output from development
docs/*_output.txt
docs/*_run.txt
docs/venue*_raw.txt
docs/check_*.txt
docs/name_change_example.txt
docs/layout_inspection.txt
frontend/tsconfig.tsbuildinfo
